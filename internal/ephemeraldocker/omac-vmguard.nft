#!/usr/sbin/nft -f
# omac-vmguard — network boundary of the ephemeral Docker VM.
#
# Production copy of the ruleset measured in the 2026-09-09 firewall spike
# (see openspec/changes/add-ephemeral-docker). Docker's own FORWARD chain
# accepts first; this table hooks at priority filter + 10 and drops what
# Docker accepted, flipping container egress and host-canary traffic to
# blocked while pulls, published ports, and bridge-local traffic stay green.
#
# Two rules measured dead in the spike are deliberately kept (decision
# 2026-09-09), so do not remove them:
#   1. DNAT accept (0 hits with the userland docker-proxy path): fallback
#      if Docker's userland-proxy is ever disabled and published-port
#      traffic arrives DNATed through the forward hook.
#   2. Bridge-local accept `iifname != "eth0" oifname != "eth0"` (0 hits;
#      br_netfilter is not loaded on the measured guest): insurance if
#      br_netfilter ever ships loaded and routes bridge-local IP traffic
#      through the forward hook.
# Every rule carries a counter; the final explicit `counter drop` allows
# cause analysis from the guest.
table inet omac-vmguard {
  chain forward {
    type filter hook forward priority filter + 10; policy drop;
    ct state established,related counter accept
    iifname "eth0" ct status dnat counter accept
    iifname != "eth0" oifname != "eth0" counter accept
    counter drop
  }
}
